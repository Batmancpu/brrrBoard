<helium314.keyboard.latin.RoundedKeyboardFrameView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_keyboard_frame"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false" >

    <HorizontalScrollView
        android:id="@+id/persistent_emoji_row_scroll"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:scrollbars="none"
        android:visibility="gone"
        android:background="@android:color/transparent" >
        <LinearLayout
            android:id="@+id/persistent_emoji_row_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <View
        android:id="@+id/persistent_emoji_row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15808080"
        android:visibility="gone" />

    <include
        android:id="@+id/strip_container"
        layout="@layout/strip_container" />

    <!-- To ensure that key preview popup is correctly placed when the current system locale is
         one of RTL locales, layoutDirection="ltr" is needed in the SDK version 17+. -->
    <helium314.keyboard.latin.KeyboardWrapperView
        android:id="@+id/keyboard_view_wrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:clipChildren="false"
        android:clipToPadding="false" >

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/keyboard_view"
            android:layoutDirection="ltr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <include
            android:id="@+id/emoji_palettes_view"
            layout="@layout/emoji_palettes_view" />
        <include
            android:id="@+id/clipboard_history_view"
            layout="@layout/clipboard_history_view" />
        <include
            android:id="@+id/klipy_palettes_view"
            layout="@layout/klipy_palettes_view" />
        <helium314.keyboard.keyboard.AccessPointMenuView
            android:id="@+id/access_point_menu_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
        <helium314.keyboard.keyboard.internal.AiWritingToolsView
            android:id="@+id/ai_writing_tools_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_stop_one_handed_mode"
            android:contentDescription="@string/label_stop_onehanded_mode_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_switch_one_handed_mode"
            android:contentDescription="@string/label_switch_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

        <ImageButton
            android:id="@+id/btn_resize_one_handed_mode"
            android:contentDescription="@string/label_resize_onehanded_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:scaleType="fitCenter"
            style="?attr/suggestionWordStyle" />

    </helium314.keyboard.latin.KeyboardWrapperView>

    <helium314.keyboard.latin.BoardFooterView
        android:id="@+id/board_footer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/config_board_footer_height"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/board_footer_voice_error"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxWidth="230dp"
            android:minWidth="72dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="12sp"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <!-- Normally absent. One ephemeral, owned action in the empty region
             between the fixed Emoji/ABC and mic buttons. No extra footer row. -->
        <TextView
            android:id="@+id/board_footer_context_action"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:maxWidth="230dp"
            android:minWidth="88dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textSize="12sp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/board_footer_globe"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:paddingBottom="@dimen/config_board_footer_icon_optical_bottom_padding"
            android:scaleType="center"
            android:src="@drawable/ic_board_emoji"
            android:contentDescription="@string/board_language_and_shortcuts"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- Cached, mic-shaped glow on the Frosted Glass surface, below the icon. -->
        <helium314.keyboard.latin.FooterMicUnderlightView
            android:id="@+id/board_footer_mic_underlight"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:clickable="false"
            android:focusable="false"
            android:enabled="false"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/board_footer_mic"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:paddingBottom="@dimen/config_board_footer_icon_optical_bottom_padding"
            android:scaleType="center"
            android:src="@drawable/ic_board_mic"
            android:contentDescription="@string/board_inline_dictation"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <!-- Only shown for password editors when Proton Pass is actually installed.
             A launch shortcut, not a custom credential/autofill implementation. -->
        <ImageButton
            android:id="@+id/board_footer_password_manager"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:paddingBottom="@dimen/config_board_footer_icon_optical_bottom_padding"
            android:scaleType="center"
            android:src="@drawable/ic_board_password_key"
            android:contentDescription="@string/board_proton_pass_action"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

        <!-- Event-scoped full drawing canvas: bin descends from the Enter-key region,
             opens, swallows the mic and morphs into the idle white mic. -->
        <helium314.keyboard.latin.FooterMicDiscardMorphView
            android:id="@+id/board_footer_discard"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="12dp"
            android:clickable="false"
            android:focusable="false"
            android:enabled="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />
    </helium314.keyboard.latin.BoardFooterView>

</helium314.keyboard.latin.RoundedKeyboardFrameView>
