<helium314.keyboard.keyboard.clipboard.ClipboardHistoryView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:visibility="gone"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@android:color/transparent"
    style="?attr/clipboardHistoryViewStyle">

    <!-- One measured body: clips scroll behind the fixed header and bottom keys. -->
    <helium314.keyboard.keyboard.clipboard.ClipboardGlassFrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <helium314.keyboard.keyboard.clipboard.ClipboardHistoryRecyclerView
            android:id="@+id/clipboard_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/panel_content_top_inset"
            android:paddingBottom="70dp"
            android:clipToPadding="false"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/clipboard_empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/clipboard_empty_state"
            android:visibility="invisible" />

        <!-- Scrim goes behind the title, above the clips, never over text controls. -->
        <helium314.keyboard.keyboard.PanelGlassOverlayView
            android:id="@+id/clipboard_header_scrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/panel_header_fade"
            android:layout_gravity="top"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/clipboard_toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/panel_header_height"
            android:layout_gravity="top"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/clipboard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/clipboard"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/clipboard_clear_button"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|center_vertical"
                android:contentDescription="@string/clear_clipboard" />

        </FrameLayout>

        <!-- Search stays inside the IME. It never types into the host field. -->
        <LinearLayout
            android:id="@+id/clipboard_search_header"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="8dp"
            android:visibility="gone">
            <ImageButton
                android:id="@+id/clipboard_search_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="@string/abc_action_bar_up_description"
                android:padding="0dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back"/>
            <!-- The clear glyph lives INSIDE the same glass capsule. Its
                 transform appearance never changes the header's measured width. -->
            <FrameLayout
                android:id="@+id/clipboard_search_field"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/klipy_search_bar_ripple_bg"
                android:clipChildren="false">
                <View
                    android:id="@+id/clipboard_search_match_haze"
                    android:layout_width="140dp"
                    android:layout_height="28dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="11dp"
                    android:alpha="0"
                    android:clickable="false"
                    android:importantForAccessibility="no"/>
                <EditText
                    android:id="@+id/clipboard_search_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/clipboard_search_hint"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:singleLine="true"
                    android:paddingStart="15dp"
                    android:paddingEnd="42dp"
                    android:textSize="14sp"/>
                <ImageButton
                    android:id="@+id/clipboard_search_clear"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@string/clipboard_search_clear"
                    android:background="@android:color/transparent"
                    android:scaleType="center"
                    android:padding="0dp"
                    android:alpha="0"
                    android:scaleX="0.55"
                    android:scaleY="0.55"
                    android:src="@drawable/ic_close"
                    android:visibility="invisible"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Normal alphabet keyboard occupies lower area only in search mode. -->
        <FrameLayout
            android:id="@+id/clipboard_search_keyboard_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone"/>

        <!-- Fixed translucent material under crisp ABC/space/Delete controls. -->
        <helium314.keyboard.keyboard.PanelGlassOverlayView
            android:id="@+id/clipboard_bottom_glass"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no" />

        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/bottom_row_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

        <LinearLayout
            android:id="@+id/clipboard_undo_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:paddingVertical="5dp"
            android:elevation="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/clipboard_undo_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_clip_deleted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/clipboard_undo_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:gravity="center"
                android:text="@string/undo"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </helium314.keyboard.keyboard.clipboard.ClipboardGlassFrameLayout>

</helium314.keyboard.keyboard.clipboard.ClipboardHistoryView>
