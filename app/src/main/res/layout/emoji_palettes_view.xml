<helium314.keyboard.keyboard.emoji.EmojiPalettesView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:visibility="gone"
    android:background="@android:color/transparent"
    style="?attr/emojiPalettesViewStyle"
>
    <LinearLayout
        android:id="@+id/emoji_search_bar_container"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/emoji_search_back_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@string/abc_action_bar_up_description"
            android:padding="0dp"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_back" />

        <FrameLayout
            android:id="@+id/emoji_search_box"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/klipy_search_bar_ripple_bg"
            android:paddingHorizontal="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/emoji_search_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_brr_search" />

                <EditText
                    android:id="@+id/emoji_search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="@string/search_field_placeholder"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text|textNoSuggestions"
                    android:padding="0dp"
                    android:selectAllOnFocus="false"
                    android:singleLine="true"
                    android:textColor="@color/textColorPrimary"
                    android:textColorHint="@color/foreground_weak"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/emoji_search_clear_button"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/emoji_search_results_scroll"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        android:visibility="gone">

        <helium314.keyboard.keyboard.emoji.EmojiPageKeyboardView
            android:id="@+id/emoji_search_results_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/emoji_search_empty"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="@string/emoji_search_no_results"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Smart picks are a transient, separate row; user Recents remain in the
         existing virtualized grid below. Hidden entirely for weak/no context. -->
    <LinearLayout
        android:id="@+id/emoji_context_smart_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/emoji_context_smart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emoji_context_smart_title"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/emoji_context_recent_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/emoji_context_recent_below"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/emoji_context_smart_row"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </LinearLayout>

    <helium314.keyboard.keyboard.emoji.EmojiGlassFrameLayout
        android:id="@+id/emoji_grid_shell"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/emoji_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />
        <!-- Same shared material as Toolbar/Clipboard; crisp tabs stay above. -->
        <helium314.keyboard.keyboard.PanelGlassOverlayView
            android:id="@+id/emoji_header_scrim"
            android:layout_width="match_parent"
            android:layout_height="@dimen/panel_emoji_header_fade"
            android:layout_gravity="top"
            android:visibility="gone"
            android:importantForAccessibility="no" />
        <helium314.keyboard.keyboard.PanelGlassOverlayView
            android:id="@+id/emoji_bottom_glass"
            android:layout_width="match_parent"
            android:layout_height="@dimen/panel_bottom_glass_height"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no" />
        <!-- Fixed action keys are composed ABOVE the live, scrolling glass.
             The RecyclerView fills the whole shell underneath these keys. -->
        <helium314.keyboard.keyboard.MainKeyboardView
            android:id="@+id/bottom_row_keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

        <!-- Category tabs live in the fixed upper strip outside this scroll viewport.
             Search / Space / Backspace use the full-width native bottom key row. -->
    </helium314.keyboard.keyboard.emoji.EmojiGlassFrameLayout>
    <helium314.keyboard.keyboard.emoji.EmojiCategoryPageIndicatorView
        android:id="@+id/emoji_category_page_id_view"
        android:layout_width="match_parent"
        android:layout_height="2dip" />
    <View
        android:id="@+id/emoji_search_keyboard_placeholder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

</helium314.keyboard.keyboard.emoji.EmojiPalettesView>
